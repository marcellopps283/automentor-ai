# Gemini / Google AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (for creating lab repositories)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_USERNAME=your_github_username

# Google Cloud Firestore (Optional for cloud storage; defaults to local JSON memory if empty)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Google Calendar (Optional credentials path; falls back to Mock Calendar if empty)
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json

# Demo Mode (true enables realistic simulations for calendar/github if credentials are not configured)
DEMO_MODE=true
